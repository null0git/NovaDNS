[Unit]
Description=NovaDNS - Enterprise self-hosted DNS platform
After=network.target

[Service]
Type=simple
User=novadns
Group=novadns
WorkingDirectory=/opt/novadns
Environment=NOVADNS_DB=/opt/novadns/data/novadns.sqlite
Environment=NOVADNS_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-VALUE
Environment=NOVADNS_DNS_PORT=53
Environment=NOVADNS_WEB_PORT=8080
ExecStart=/usr/bin/python3 /opt/novadns/run.py
Restart=on-failure
RestartSec=3

# Grants binding to port 53 without running the whole process as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
